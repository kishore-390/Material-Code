# ============================================================
# ONE NATION - ONE COMMON MATERIAL CODE
# Environment configuration (copy to .env before running)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=material_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=material_harmonization
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://material_admin:change_this_password@postgres:5432/material_harmonization

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
JWT_SECRET_KEY=CHANGE_ME_super_secret_key_for_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- File storage ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=15

# --- AI ---
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
EMBEDDING_DIM=384
IMAGE_EMBEDDING_DIM=512
AI_USE_MOCK_FALLBACK=true

# --- Decision thresholds (can be overridden in Admin > Settings) ---
THRESHOLD_AUTO=95
THRESHOLD_REVIEW=85
THRESHOLD_LOW=60

# --- Scoring weights (must sum to 1.0) ---
WEIGHT_DESCRIPTION=0.30
WEIGHT_SPECIFICATION=0.25
WEIGHT_CATEGORY=0.15
WEIGHT_UOM=0.10
WEIGHT_IMAGE=0.15
WEIGHT_ATTRIBUTES=0.05

# --- CORS ---
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api

# --- pgAdmin (optional) ---
PGADMIN_DEFAULT_EMAIL=admin@material.gov.in
PGADMIN_DEFAULT_PASSWORD=admin
