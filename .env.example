# ============================================================
# ONE NATION - ONE COMMON MATERIAL CODE
# AI-Powered National Unified Material Master Platform
# Environment configuration (copy to .env before running)
# ============================================================

# --- PostgreSQL (central material database) ---
POSTGRES_USER=material_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=material_harmonization
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://material_admin:change_this_password@postgres:5432/material_harmonization

# --- Redis / Celery (background sync + AI processing) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
JWT_SECRET_KEY=CHANGE_ME_super_secret_key_for_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI model configuration ---
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
AI_USE_MOCK_FALLBACK=true

# --- Decision thresholds (also editable at runtime from Governance > Rules & Policies) ---
THRESHOLD_AUTO=95
THRESHOLD_REVIEW=85
THRESHOLD_LOW=60

# --- Scoring weights (must sum to 1.0) ---
WEIGHT_DESCRIPTION=0.20
WEIGHT_SPECIFICATION=0.15
WEIGHT_CLASSIFICATION=0.10
WEIGHT_UOM=0.05
WEIGHT_ATTRIBUTES=0.05
WEIGHT_GRADE=0.15
WEIGHT_DIMENSION=0.15
WEIGHT_STANDARD=0.05
WEIGHT_MANUFACTURER=0.03
WEIGHT_FUNCTION=0.05
WEIGHT_CRITICALITY=0.02

# --- Source connector / synchronization defaults (app.connectors) ---
# Per-CPSE connection details (host/port/db/table/column mapping) live in
# the source_connections table, configured via Governance/CPSE Network in
# the app - NEVER in this file. Each connection's read-only DB username and
# password live in environment variables named by that connection's own
# username_reference/secret_reference fields - one pair per connected CPSE,
# e.g. for a CPSE registered with username_reference=IOCL_DB_USER and
# secret_reference=IOCL_DB_PASSWORD:
# IOCL_DB_USER=change_this_to_the_real_read_only_username
# IOCL_DB_PASSWORD=change_this_to_the_real_read_only_password
SOURCE_SYNC_BEAT_TICK_SECONDS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api

# --- pgAdmin (optional, local inspection only) ---
PGADMIN_DEFAULT_EMAIL=admin@material.gov.in
PGADMIN_DEFAULT_PASSWORD=admin
